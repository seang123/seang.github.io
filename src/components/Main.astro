---
interface Props {
  wide?: boolean;
}

const { wide = false } = Astro.props;
---

<main class:list={{ wide }}>
  <slot />
</main>

<style>
  main {
    box-sizing: content-box;
    font-size: 1.4rem;
    margin: 44px auto 4rem;
    max-width: 46rem;
    padding: 0 40px;
  }

  main.wide {
    max-width: 56rem;
  }
</style>
