---
import Layout from '../layouts/Layout.astro';
import Main from '../components/Main.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const base = import.meta.env.BASE_URL;
---
<Layout title="Sean Gies">
  <Main>
    {posts.map((post) => (
      <article class="summary" itemscope>
        <a rel="bookmark" itemprop="url" href={`${base}posts/${post.slug}`}>
          <h2 itemprop="headline" class='headline'>{post.data.title}</h2>
          <p itemprop="abstract">{post.data.description}</p>
          <small class="meta category time">
            <span>{post.data.date.toISOString().slice(0, 10)}</span>
            <span>{post.data.tags?.join(', ')}</span>
          </small>
        </a>
      </article>
    ))}
  </Main>
</Layout>

<style>
  .headline{
    font-family: 'EB Garamond', helvetica, Georgia, serif;
  }
  .summary {
    border-bottom: 1px solid #ddd;
    font-size: 1.2rem;
    /*margin: 10rem;
    padding: 0 0 1.5rem;*/
    padding: 1.5rem 0.5rem;
  }

  .summary:last-of-type {
    border-bottom: 0;
    /*margin: 0;
    padding: 1rem;*/
  }

  .summary a {
    color: #555;
    display: block;
    text-decoration: none;
  }

  .summary a:hover,
  .summary a:focus,
  .summary a:active,
  .summary a:hover > *,
  .summary a:focus > *,
  .summary a:active > * {
    color: #666;
  }

  .summary:hover {
    background-color: rgb(216, 219, 223);
    border-radius: 8px;
  }

  .summary h2 {
    font-size: 1.2em;
    line-height: inherit;
    margin: 0 0 .416667em;
  }

  .summary p {
    margin: .5em 0;
  }

  .meta > * {
    color: #999;
    font-family: helvetica, arial, sans-serif;
    margin: 0 .625em 0 0;
  }
</style>
