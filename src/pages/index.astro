---
import Layout from '../layouts/Layout.astro';
import Main from '../components/Main.astro';
import { getEntry, render } from 'astro:content';

const whoAmI = await getEntry('index', 'who-am-i');

if (!whoAmI) {
  throw new Error('Missing index content: who-am-i');
}

const { Content } = await render(whoAmI);
---
<Layout title="Sean Gies">
  <Main>
    <div class='hero-name'>
      <a href='/' __target='blank'>seán gies</a>
    </div>
    <div class='who-am-i'>
      <Content />
    </div>

    <div class='links'>
      <a href='/resume'>Resume</a>
    </div>

    <div class='publications'>
      <p class='pub-title'>Publications</p>
      <a href="https://www.nature.com/articles/s10038-026-01484-9">Gies, S., Alishbayli, A., Tiesinga, P.H.E. et al. Functional effect predictions for ion channel missense variants using a protein language model. J Hum Genet 71, 595–604 (2026). https://doi.org/10.1038/s10038-026-01484-9</a>
    </div>
  </Main>
</Layout>

<style>

  .hero-name {
    font-family: 'EB Garamond', helvetica, Georgia, serif;
    padding: 4rem 0;
    font-size: 2.5rem;
  }
  .hero-name a,
  .hero-name a:hover,
  .hero-name a:visited,
  .hero-name a:active{
    color: inherit;
    text-decoration: none;
  }

  .who-am-i{
    font-family: 'Public Sans', helvetica, Georgia, serif;
  }
  .who-am-i :global(p) {
    margin: 0.75rem 0;
  }

  .links{
    padding: 4rem 0;
  }

  .pub-title{
    font-family: 'EB Garamond', helvetica, Georgia, serif;
    font-size: 2rem;
  }
  .publications{
    padding: 4rem 0;
  }

